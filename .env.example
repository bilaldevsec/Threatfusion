THREATFUSION_ENV=lab
THREATFUSION_LOG_LEVEL=INFO
THREATFUSION_DATA_DIR=/var/lib/threatfusion
THREATFUSION_ALLOWED_HOSTS=127.0.0.1,localhost
THREATFUSION_TRUSTED_PROXIES=
THREATFUSION_CONTRACT_BASE_URL=http://host.docker.internal:8766

DATABASE_URL=sqlite:///./data/processed/threatfusion_dev.sqlite3

THREATFUSION_SOAR_HMAC_SECRET=
THREATFUSION_SENSOR_INGEST_TOKEN=
THREATFUSION_LIVE_WRITE_TOKEN=
THREATFUSION_MISP_API_KEY=
THREATFUSION_THEHIVE_API_KEY=

TF_ADMIN_EMAIL=
TF_ADMIN_SECRET=
THREATFUSION_ENTRA_TENANT_ID=
THREATFUSION_ENTRA_ISSUER=
THREATFUSION_ENTRA_AUDIENCE=
THREATFUSION_ENTRA_JWKS_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-configured-at-runtime
GEMINI_ENABLED=false

ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false

MISP_URL=
MISP_API_KEY=
MISP_ENABLED=false

THEHIVE_URL=
THEHIVE_API_KEY=
THEHIVE_ENABLED=false

PIHOLE_URL=
PIHOLE_API_KEY=
PIHOLE_ENABLED=false
PIHOLE_DRY_RUN=true
